{
  "name": "__MSG_ext_name__",
  "version": "1.2.1",
  "author": "Gordon Tsai (based on md-reader by Bener, MIT)",
  "manifest_version": 3,
  "description": "__MSG_ext_desc__",
  "default_locale": "en",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "512": "images/icon-512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["css/*", "fonts/*", "images/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["table.html"],
      "matches": ["file:///*"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "AnyRead MD",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["file:///*"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "js": ["js/content.js"],
      "css": ["css/content.css"],
      "matches": [
        "file://*/*.md",
        "file://*/*.mdx",
        "file://*/*.mkd",
        "file://*/*.markdown",
        "file://*/*.MD",
        "file://*/*.MDX",
        "file://*/*.MKD",
        "file://*/*.MARKDOWN",
        "file://*/*.md?*",
        "file://*/*.mdx?*",
        "file://*/*.mkd?*",
        "file://*/*.markdown?*",
        "file://*/*.MD?*",
        "file://*/*.MDX?*",
        "file://*/*.MKD?*",
        "file://*/*.MARKDOWN?*",
        "file://*/*.mmd",
        "file://*/*.mmd?*",
        "file://*/*.mermaid",
        "file://*/*.mermaid?*",
        "file://*/*.MMD",
        "file://*/*.MMD?*",
        "file://*/*.MERMAID",
        "file://*/*.MERMAID?*",
        "file://*/*.txt",
        "file://*/*.txt?*",
        "file://*/*.TXT",
        "file://*/*.TXT?*"
      ],
      "all_frames": true
    },
    {
      "matches": ["file:///*/"],
      "js": ["js/dir-frame.js"],
      "css": ["css/dir-frame.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggleSide": {
      "description": "__MSG_command_toggle_side__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "toggleCentered": {
      "description": "__MSG_command_toggle_centered__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggleRefresh": {
      "description": "__MSG_command_toggle_refresh__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggleTheme": {
      "description": "__MSG_command_toggle_theme__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
